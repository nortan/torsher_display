server {
    listen 80;
    server_name display.local;
    root /var/www/torsher-display;
    index index.html;

    # данные и версия — без кеша, чтобы экран сразу видел обновления
    location ~* ^/(content/.*\.(json|js)|build\.json)$ {
        add_header Cache-Control "no-store";
    }

    location ~* \.(js|css|woff2|webp|png|jpg|jpeg|svg)$ {
        add_header Cache-Control "public, max-age=86400";
    }
}

